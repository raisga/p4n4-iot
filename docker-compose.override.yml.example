# ==============================================================================
# docker-compose.override.yml — Local Overrides Example
# ==============================================================================
# Copy to docker-compose.override.yml and uncomment the sections you need.
# Docker Compose automatically merges this file with docker-compose.yml.
# DO NOT commit docker-compose.override.yml (it's in .gitignore).
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
# ==============================================================================

services:

  # ----------------------------------------------------------------------------
  # Node-RED: expose the Node.js inspector, or mount nodes under development
  # (published packages: NODE_RED_PACKAGES in .env)
  # ----------------------------------------------------------------------------
  # node-red:
  #   ports:
  #     - "127.0.0.1:9229:9229"   # Node.js inspector for debugging
  #   environment:
  #     NODE_OPTIONS: --inspect=0.0.0.0:9229
  #   volumes:
  #     - ./config/node-red/custom-nodes:/data/node_modules/custom:ro

  # ----------------------------------------------------------------------------
  # InfluxDB: custom retention or data directory mount
  # ----------------------------------------------------------------------------
  # influxdb:
  #   volumes:
  #     - /mnt/data/influxdb:/var/lib/influxdb2   # external storage

  # ----------------------------------------------------------------------------
  # Grafana: development mode with anonymous access
  # ----------------------------------------------------------------------------
  # grafana:
  #   environment:
  #     GF_AUTH_ANONYMOUS_ENABLED: "true"
  #     GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer

  # ----------------------------------------------------------------------------
  # Telegraf: Docker container metrics (CPU, memory, network per container).
  # Add [[inputs.docker]] with endpoint = "unix:///var/run/docker.sock" to
  # config/telegraf/telegraf.conf. The socket gives read access to every
  # container's configuration, environment included.
  # ----------------------------------------------------------------------------
  # telegraf:
  #   volumes:
  #     - /var/run/docker.sock:/var/run/docker.sock:ro
  #   group_add:
  #     - "${DOCKER_GID:-999}"   # getent group docker | cut -d: -f3
