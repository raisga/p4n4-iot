# ==============================================================================
# MING Stack .gitignore
# ==============================================================================

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Local compose overrides
docker-compose.override.yml

# Docker volumes (if mounted locally)
data/

# make backup
backups/

# Mosquitto auth files (generated, contain hashed passwords)
config/mosquitto/passwd
config/mosquitto/acl
config/mosquitto/certs/*
!config/mosquitto/certs/.gitkeep

# Node-RED
config/node-red/flows/flows_cred.json
config/node-red/flows/.*.backup

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# SEDA agents
.agents/
