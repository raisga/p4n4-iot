# ==============================================================================
# MING Stack Environment Configuration
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC

# Services to run, comma-separated. Every service is optional; this default is
# the MING stack. Node-RED needs mqtt and influxdb, Grafana needs influxdb.
#   MING:      mqtt, influxdb, node-red, grafana
#   Optional:  telegraf  host and broker metrics (Stack Health dashboard)
#              loki,alloy  container logs (Stack Logs dashboard); Alloy needs loki
#              mqtt-ui   MQTT web client (MQTTX Web)
COMPOSE_PROFILES=mqtt,influxdb,node-red,grafana

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `p4n4 up`
# (also: always, on-failure). Apply a change with `p4n4 up`.
RESTART_POLICY=unless-stopped

# Docker's log files per container: rotated at LOG_MAX_SIZE, LOG_MAX_FILE kept
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Subnet of the shared p4n4-net network. Change it if it overlaps a VPN or a
# LAN; it takes effect once the network is recreated (README: Ports and Network).
P4N4_SUBNET=172.20.0.0/16

# ------------------------------------------------------------------------------
# Ports
# ------------------------------------------------------------------------------
# Host port and address each service is published on. 0.0.0.0: every
# interface; 127.0.0.1: this machine only (e.g. InfluxDB behind a proxy).
MQTT_BIND=0.0.0.0
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_TLS_PORT=8883
INFLUXDB_BIND=0.0.0.0
INFLUXDB_PORT=8086
NODE_RED_BIND=0.0.0.0
NODE_RED_PORT=1880
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000
MQTT_UI_BIND=0.0.0.0
MQTT_UI_PORT=8081

# ------------------------------------------------------------------------------
# MQTT device logins
# ------------------------------------------------------------------------------
# Empty MQTT_PASSWORD: devices connect anonymously. Set both: devices (MQTT_PORT,
# MQTT_WS_PORT, MQTT_TLS_PORT) must log in, with this account or one in
# config/mosquitto/passwd (`make mqtt-user NAME=<name>`). Node-RED, Telegraf
# and the ai stack use the internal listener on p4n4-net and need no login.
# Topic access per account: config/mosquitto/acl (see acl.example).
MQTT_USER=
MQTT_PASSWORD=
# TLS listener for devices (MQTT_TLS_PORT): certificate (chain) and key in
# config/mosquitto/certs/. Empty: no TLS listener.
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=

# ------------------------------------------------------------------------------
# MQTT bridge to an external broker (inbound only)
# ------------------------------------------------------------------------------
# Pulls topics from another broker into the local one, like a long-running
# `mosquitto_sub -h <host> -u <user> -P <password> -t <topic>`. Nothing is
# published back. Leave MQTT_REMOTE_HOST empty to disable the bridge.
# Connection state: `make bridge-status`.
MQTT_REMOTE_HOST=
# Default: 8883 with TLS, 1883 without
MQTT_REMOTE_PORT=
MQTT_REMOTE_USER=
MQTT_REMOTE_PASSWORD=
# Comma-separated topic filters, e.g. sensors/#,factory/+/+/celsius
MQTT_REMOTE_TOPICS=sensors/#
# Prepended to bridged topics locally, e.g. remote/ (empty: keep remote topic names)
MQTT_REMOTE_PREFIX=
MQTT_REMOTE_QOS=0
# Default: p4n4-bridge-<container id>; set one if the broker restricts client IDs
MQTT_REMOTE_CLIENT_ID=
MQTT_REMOTE_TLS=false
# With TLS: a CA file in config/mosquitto/certs/ (empty: system CA bundle), and
# a client certificate and key there for brokers that require mutual TLS
MQTT_REMOTE_CA_FILE=
MQTT_REMOTE_CERT_FILE=
MQTT_REMOTE_KEY_FILE=

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Bucket names: Node-RED, Telegraf and Grafana (data sources, dashboards and
# alerts) all follow them. Bucket names and retentions apply when InfluxDB
# creates the buckets, on its first start (`make influx-init` adds missing ones).
# Retention: e.g. 7d, 30d, 365d; 0 keeps data forever.
INFLUXDB_BUCKET=raw_telemetry                 # inbound sensor readings
INFLUXDB_RAW_RETENTION=30d
INFLUXDB_BUCKET_PROCESSED=processed_metrics   # hourly rollups of the readings
INFLUXDB_PROCESSED_RETENTION=365d
INFLUXDB_BUCKET_AI_EVENTS=ai_events           # AI annotations & anomaly flags
INFLUXDB_AI_EVENTS_RETENTION=0
INFLUXDB_BUCKET_HEALTH=system_health          # stack component metrics (Telegraf)
INFLUXDB_HEALTH_RETENTION=7d
INFLUXDB_SANDBOX_BUCKET=sandbox               # development/testing
INFLUXDB_SANDBOX_RETENTION=30d

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword
# true lets other sites show Grafana in a frame. The p4n4-dashboard web UI
# needs it for its Grafana tab; `p4n4 init` sets it when the dashboard layer is
# enabled. Leave false otherwise (clickjacking risk).
GRAFANA_ALLOW_EMBEDDING=false
# Path Grafana serves under. /grafana/ when p4n4-dashboard proxies Grafana on
# its own origin (e.g. behind HTTPS); Grafana is then at :3000/grafana/ too.
GRAFANA_SUB_PATH=/

# ------------------------------------------------------------------------------
# Node-RED
# ------------------------------------------------------------------------------
# Login for the editor and the Admin API. If NODE_RED_PASSWORD is empty,
# every login is refused.
NODE_RED_USER=admin
NODE_RED_PASSWORD=adminpassword
# Key that encrypts credentials saved in flows (flows/flows_cred.json). Empty:
# Node-RED generates one inside the node-red-data volume, and the credentials
# are lost with that volume. Set it once; changing it later makes them unreadable.
NODE_RED_CREDENTIAL_SECRET=
# npm packages installed into Node-RED on start, comma-separated. For Node-RED
# Dashboard 2 (operator UIs at http://<host>:1880/dashboard):
#   NODE_RED_PACKAGES=@flowfuse/node-red-dashboard@1
NODE_RED_PACKAGES=
# Bearer token for the p4n4-system1 subflow: the same value as SYSTEM1_API_KEY in
# the ai stack's .env (`p4n4 ai system1 enable` sets both). Empty = the subflow
# answers every message with msg.error, and nothing else changes.
SYSTEM1_API_KEY=
# Bearer token Grafana's System 1 drift alerts send to n8n's system1-drift webhook:
# the same value as SYSTEM1_ALERT_TOKEN in the ai stack's .env. Empty = n8n refuses them.
SYSTEM1_ALERT_TOKEN=

# ------------------------------------------------------------------------------
# Telegraf (profile "telegraf")
# ------------------------------------------------------------------------------
# Host metrics and Mosquitto broker stats, written to INFLUXDB_BUCKET_HEALTH
TELEGRAF_HOSTNAME=p4n4
TELEGRAF_INTERVAL=10s

# ------------------------------------------------------------------------------
# Loki (profile "loki")
# ------------------------------------------------------------------------------
# How long container logs are kept (hours: 168h = 7 days)
LOKI_RETENTION=168h
