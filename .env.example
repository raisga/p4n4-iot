# ==============================================================================
# MING Stack Environment Configuration
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# IMPORTANT: Change all default passwords and tokens before production use!
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC

# Services to run, comma-separated. Every service is optional; this default is
# the MING stack. Add telegraf for host and broker metrics. Node-RED needs mqtt
# and influxdb, Grafana needs influxdb.
#   Available: mqtt, influxdb, node-red, grafana, telegraf
COMPOSE_PROFILES=mqtt,influxdb,node-red,grafana

# ------------------------------------------------------------------------------
# MQTT bridge to an external broker (inbound only)
# ------------------------------------------------------------------------------
# Pulls topics from another broker into the local one, like a long-running
# `mosquitto_sub -h <host> -u <user> -P <password> -t <topic>`. Nothing is
# published back. Leave MQTT_REMOTE_HOST empty to disable the bridge.
# Connection state: `make bridge-status`.
MQTT_REMOTE_HOST=
# Default: 8883 with TLS, 1883 without
MQTT_REMOTE_PORT=
MQTT_REMOTE_USER=
MQTT_REMOTE_PASSWORD=
# Comma-separated topic filters, e.g. sensors/#,factory/+/+/celsius
MQTT_REMOTE_TOPICS=sensors/#
# Prepended to bridged topics locally, e.g. remote/ (empty: keep remote topic names)
MQTT_REMOTE_PREFIX=
MQTT_REMOTE_QOS=0
# Default: p4n4-bridge-<container id>; set one if the broker restricts client IDs
MQTT_REMOTE_CLIENT_ID=
MQTT_REMOTE_TLS=false
# With TLS: a CA file in config/mosquitto/certs/ (empty: system CA bundle), and
# a client certificate and key there for brokers that require mutual TLS
MQTT_REMOTE_CA_FILE=
MQTT_REMOTE_CERT_FILE=
MQTT_REMOTE_KEY_FILE=

# ------------------------------------------------------------------------------
# InfluxDB
# ------------------------------------------------------------------------------
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminpassword
INFLUXDB_ORG=ming
INFLUXDB_TOKEN=p4n4-stack-token

# Primary bucket (created automatically by InfluxDB init, 30d retention)
INFLUXDB_BUCKET=raw_telemetry
INFLUXDB_RAW_RETENTION=30d                    # retention of the primary bucket (first run only)

# Additional buckets (created by init-buckets.sh)
INFLUXDB_BUCKET_PROCESSED=processed_metrics   # downsampled data, 365d
INFLUXDB_BUCKET_AI_EVENTS=ai_events           # AI annotations & anomaly flags, infinite
INFLUXDB_BUCKET_HEALTH=system_health          # stack component metrics, 7d (Telegraf)

# Sandbox bucket for development/testing
INFLUXDB_SANDBOX_BUCKET=sandbox
INFLUXDB_SANDBOX_RETENTION=30d

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=adminpassword
# true lets other sites show Grafana in a frame. The p4n4-dashboard web UI
# needs it for its Grafana tab; `p4n4 init` sets it when the dashboard layer is
# enabled. Leave false otherwise (clickjacking risk).
GRAFANA_ALLOW_EMBEDDING=false
# Path Grafana serves under. /grafana/ when p4n4-dashboard proxies Grafana on
# its own origin (e.g. behind HTTPS); Grafana is then at :3000/grafana/ too.
GRAFANA_SUB_PATH=/

# ------------------------------------------------------------------------------
# Node-RED
# ------------------------------------------------------------------------------
# Login for the editor and the Admin API. If NODE_RED_PASSWORD is empty,
# every login is refused.
NODE_RED_USER=admin
NODE_RED_PASSWORD=adminpassword

# ------------------------------------------------------------------------------
# Telegraf (profile "telegraf")
# ------------------------------------------------------------------------------
# Host metrics and Mosquitto broker stats, written to INFLUXDB_BUCKET_HEALTH
TELEGRAF_HOSTNAME=p4n4
TELEGRAF_INTERVAL=10s
